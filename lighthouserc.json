{
    "ci": {
        "collect": {
            "numberOfRuns": 3,
            "url": [
                "https://sync-sunat.pages.dev/"
            ]
        },
        "assert": {
            "assertions": {
                "categories:performance": [
                    "error",
                    {
                        "minScore": 0.85
                    }
                ],
                "categories:accessibility": [
                    "error",
                    {
                        "minScore": 0.88
                    }
                ]
            }
        },
        "upload": {
            "target": "temporary-public-storage"
        }
    }
}
