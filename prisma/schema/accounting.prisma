// prisma/schema/accounting.prisma

enum EntryStatus {
  BORRADOR
  ASENTADO
  ANULADO
}

enum AccountingPeriodStatus {
  ABIERTO
  CERRADO
}

/// Catálogo PCGE 2019. Es global: no depende de la empresa.


/// Gasto operativo con su asiento contable automático.
model Expense {
  id               String   @id @default(uuid())
  company_id       String
  company          Company  @relation(fields: [company_id], references: [id], onDelete: Restrict)
  expense_date     DateTime
  supplier_name    String
  supplier_doc     String?
  document_type    String   @default("01")
  document_number  String?
  description      String
  base_amount      Decimal  @db.Decimal(14, 2)
  igv_amount       Decimal  @db.Decimal(14, 2)
  total_amount     Decimal  @db.Decimal(14, 2)
  paid_amount      Decimal  @default(0.00) @db.Decimal(14, 2)
  status           String   @default("REGISTRADO")
  created_at       DateTime @default(now())

  distributions    ExpenseDistribution[]

  @@index([company_id, expense_date])
  @@map("expenses")
}

/// Reparto de la base de un gasto entre varias cuentas contables.
///
/// La base se reparte en importes exactos (o porcentajes que suman 100) y el
/// asiento carga cada cuenta con su parte; el IGV y la cuenta por pagar siguen
/// saliendo de las reglas del proceso GASTO.
model ExpenseDistribution {
  id           String   @id @default(uuid())
  expense_id   String
  expense      Expense  @relation(fields: [expense_id], references: [id], onDelete: Cascade)
  company_id   String
  account_code String
  amount       Decimal  @db.Decimal(14, 2)
  percentage   Decimal  @db.Decimal(5, 2)
  created_at   DateTime @default(now())

  @@unique([expense_id, account_code])
  @@index([company_id, account_code])
  @@map("expense_distributions")
}


/// Cobro de una cuenta por cobrar comercial.
model Collection {
  id              String   @id @default(uuid())
  company_id      String
  company         Company  @relation(fields: [company_id], references: [id], onDelete: Restrict)
  collection_date DateTime
  customer_name   String
  customer_doc    String?
  invoice_number  String?
  invoice_id      String?
  description     String
  amount          Decimal  @db.Decimal(14, 2)
  payment_method  String   @default("TRANSFERENCIA")
  bank_name       String?
  status          String   @default("REGISTRADO")
  created_at      DateTime @default(now())

  distributions   CollectionDistribution[]

  @@index([company_id, collection_date])
  @@map("collections")
}

/// Reparto del importe de un cobro entre varias cuentas por cobrar.
model CollectionDistribution {
  id           String     @id @default(uuid())
  collection_id String
  collection   Collection @relation(fields: [collection_id], references: [id], onDelete: Cascade)
  company_id   String
  account_code String
  amount       Decimal    @db.Decimal(14, 2)
  percentage   Decimal    @db.Decimal(5, 2)
  created_at   DateTime   @default(now())

  @@unique([collection_id, account_code])
  @@index([company_id, account_code])
  @@map("collection_distributions")
}

/// Ejercicio fiscal por empresa. Agrupa los períodos mensuales.
model AccountingFiscalYear {
  id         String   @id @default(uuid())
  company_id String
  company    Company  @relation(fields: [company_id], references: [id], onDelete: Restrict)
  year       Int
  status     String   @default("ABIERTO")
  opened_at  DateTime @default(now())
  closed_at  DateTime?

  @@unique([company_id, year])
  @@index([company_id, status])
  @@map("accounting_fiscal_years")
}

/// Regla de contabilización por proceso, documento y línea.
model AccountingRule {
  id               String   @id @default(uuid())
  company_id       String
  company          Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  process_code     String
  document_type    String   @default("*")
  line_order       Int
  account_code     String
  side             String
  base_calculation String
  description      String?
  is_active        Boolean  @default(true)

  @@unique([company_id, process_code, document_type, line_order])
  @@index([company_id, process_code, is_active])
  @@map("accounting_rules")
}

model AccountingAccount {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  element     String
  nature      String
  parent_code String?
  level       Int
  is_active   Boolean  @default(true)

  @@index([parent_code])
  @@index([element])
  @@map("accounting_accounts")
}

/// Período contable por empresa. El asiento solo se permite si está ABIERTO.
model AccountingPeriod {
  id         String                 @id @default(uuid())
  company_id String
  company    Company                @relation(fields: [company_id], references: [id], onDelete: Restrict)
  period     String
  year       Int
  month      Int
  status     AccountingPeriodStatus @default(ABIERTO)
  opened_at  DateTime               @default(now())
  closed_at  DateTime?

  @@unique([company_id, period])
  @@index([company_id, year, month])
  @@map("accounting_periods")
}

model AccountingEntry {
  id                    String            @id @default(uuid())
  company_id            String
  company               Company           @relation(fields: [company_id], references: [id], onDelete: Restrict)
  period                String
  entry_number          Int
  entry_date            DateTime
  glosa                 String
  source_module         String
  journal_code          String            @default("OPV")
  source_reference_id   String?
  idempotency_key       String?
  total_debit           Decimal           @db.Decimal(14, 2)
  total_credit          Decimal           @db.Decimal(14, 2)
  is_balanced           Boolean
  status                EntryStatus       @default(ASENTADO)
  created_at            DateTime          @default(now())

  lines                 AccountingLine[]

  @@unique([company_id, period, entry_number])
  @@unique([company_id, idempotency_key])
  @@index([company_id, period, entry_date])
  @@map("accounting_entries")
}

model AccountingLine {
  id              String          @id @default(uuid())
  entry_id        String
  entry           AccountingEntry @relation(fields: [entry_id], references: [id], onDelete: Cascade)
  line_order      Int
  account_code    String
  account_name    String
  debit_amount    Decimal         @default(0.00) @db.Decimal(14, 2)
  credit_amount   Decimal         @default(0.00) @db.Decimal(14, 2)

  @@index([entry_id, line_order])
  @@index([account_code])
  @@map("accounting_lines")
}

/// Cuenta de tesorería de la empresa: alias operativo sobre una subcuenta PCGE.
///
/// El catálogo `accounting_accounts` es el PCGE oficial y es global; la empresa
/// necesita, además, saber **cuáles** de esas subcuentas usa y con qué nombre
/// operativo ("BCP cuenta corriente", "Caja chica taller"). Sin esta tabla el
/// código tenía que adivinar con `'101'` o `'1041'` según el medio de pago.
model CompanyTreasuryAccount {
  id         String   @id @default(uuid())
  company_id String
  company    Company  @relation(fields: [company_id], references: [id], onDelete: Restrict)
  /// Subcuenta PCGE usada en el asiento (ej. 1041).
  code       String
  /// Nombre operativo que ve el usuario (ej. "BCP cuenta corriente").
  name       String
  /// CAJA | BANCO. Determina el filtro por medio de pago en tesorería.
  kind       String   @default("BANCO")
  currency   String   @default("PEN")
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  @@unique([company_id, code])
  @@index([company_id, is_active])
  @@map("company_treasury_accounts")
}

model PleBook {
  id                  String        @id @default(uuid())
  company_id          String
  company             Company       @relation(fields: [company_id], references: [id], onDelete: Restrict)
  period              String
  book_code           String
  official_file_name  String
  records_count       Int
  total_taxable_base  Decimal       @db.Decimal(14, 2)
  total_igv           Decimal       @db.Decimal(14, 2)
  total_amount        Decimal       @db.Decimal(14, 2)
  file_storage_url    String
  file_sha256_hash    String
  generated_by        String?
  generator           User?         @relation(fields: [generated_by], references: [id], onDelete: SetNull)
  generated_at        DateTime      @default(now())

  @@index([company_id, period, book_code])
  @@map("ple_books")
}
