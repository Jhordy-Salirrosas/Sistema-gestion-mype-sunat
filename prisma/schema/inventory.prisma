// prisma/schema/inventory.prisma

enum InventoryMovementDirection {
  ENTRADA
  SALIDA
}

enum InventoryObligationStatus {
  OBLIGATORIO
  EXCEPTUADO
  VOLUNTARIO
}

model InventoryWarehouse {
  id                        String              @id @default(uuid())
  company_id                String
  company                   Company             @relation(fields: [company_id], references: [id], onDelete: Restrict)
  warehouse_code            String
  sunat_establishment_code  String              @default("0000")
  description               String
  address                   String?
  is_active                 Boolean             @default(true)
  created_at                DateTime            @default(now())
  updated_at                DateTime            @updatedAt

  balances                  InventoryBalance[]
  movements                 InventoryMovement[]
  cost_layers               InventoryCostLayer[]
  user_access               UserWarehouse[]

  @@unique([company_id, warehouse_code])
  @@index([company_id])
  @@map("inventory_warehouses")
}

model InventoryProduct {
  id                    String              @id @default(uuid())
  company_id            String
  company               Company             @relation(fields: [company_id], references: [id], onDelete: Restrict)
  sku                   String
  description           String
  sunat_type_code       String              @default("01") // Tabla 5 SUNAT (01 Mercaderías, 02 Prod. Terminado, etc.)
  sunat_unit_code       String              @default("NIU") // Tabla 6 SUNAT (NIU, KGM, LTR, etc.)
  min_stock_alert       Decimal             @default(0.0000) @db.Decimal(12, 4)

  // Fase 1: distinción producto/servicio y datos de importación.
  is_inventory          Boolean             @default(true)
  hs_code               String?
  category              String?
  brand                 String?
  model                 String?
  barcode               String?
  tax_affectation       String?             // Catálogo 07 por defecto
  weight_kg             Decimal?            @db.Decimal(12, 4)
  volume_m3             Decimal?            @db.Decimal(12, 4)
  default_supplier_id   String?
  default_supplier      BusinessPartner?    @relation("ProductDefaultSupplier", fields: [default_supplier_id], references: [id], onDelete: SetNull)

  // Fase 2: Clasificación, origen y mantenedores
  origin_type           String              @default("NACIONAL") // NACIONAL | IMPORTADO
  is_service            Boolean             @default(false)
  manufacturer          String?
  tags                  String[]            @default([])
  country_of_origin     String?             @default("PE")

  // Precios y reglas comerciales
  cost_price            Decimal?            @db.Decimal(14, 4)
  sale_price            Decimal?            @db.Decimal(14, 2)
  wholesale_price       Decimal?            @db.Decimal(14, 2)
  promo_price           Decimal?            @db.Decimal(14, 2)
  commission_rate       Decimal?            @db.Decimal(5, 2)
  min_price             Decimal?            @db.Decimal(14, 2)
  warehouse_location    String?

  is_active             Boolean             @default(true)
  created_at            DateTime            @default(now())
  updated_at            DateTime            @updatedAt
  cost_layers           InventoryCostLayer[]

  balances              InventoryBalance[]
  movements             InventoryMovement[]
  purchase_items        NationalPurchaseItem[]
  suppliers             InventoryProductSupplier[]
  presentations         InventoryProductPresentation[]
  variants              InventoryProductVariant[]
  attributes            Json?               // Atributos de variación: ["Color", "Medida", "Acabado"]

  @@unique([company_id, sku])
  @@index([company_id])
  @@index([company_id, is_inventory])
  @@index([default_supplier_id])
  @@map("inventory_products")
}

model InventoryBalance {
  id                          String             @id @default(uuid())
  company_id                  String
  company                     Company            @relation(fields: [company_id], references: [id], onDelete: Restrict)
  warehouse_id                String
  warehouse                   InventoryWarehouse @relation(fields: [warehouse_id], references: [id], onDelete: Restrict)
  product_id                  String
  product                     InventoryProduct   @relation(fields: [product_id], references: [id], onDelete: Restrict)
  current_stock               Decimal            @default(0.0000) @db.Decimal(12, 4)
  average_unit_cost           Decimal            @default(0.0000) @db.Decimal(14, 4)
  total_inventory_value       Decimal            @default(0.00) @db.Decimal(14, 2)
  last_movement_at            DateTime?
  updated_at                  DateTime           @updatedAt

  @@unique([company_id, warehouse_id, product_id])
  @@index([company_id, warehouse_id])
  @@index([company_id, product_id])
  @@map("inventory_balances")
}

model InventoryCostLayer {
  id                 String             @id @default(uuid())
  company_id         String
  company            Company            @relation(fields: [company_id], references: [id], onDelete: Restrict)
  warehouse_id       String
  warehouse          InventoryWarehouse @relation(fields: [warehouse_id], references: [id], onDelete: Restrict)
  product_id         String
  product            InventoryProduct   @relation(fields: [product_id], references: [id], onDelete: Restrict)
  quantity_remaining Decimal            @db.Decimal(12, 4)
  unit_cost          Decimal            @db.Decimal(14, 4)
  source_movement_id String?
  entry_order        BigInt             @default(autoincrement())
  created_at         DateTime           @default(now())

  @@index([company_id, warehouse_id, product_id, entry_order])
  @@map("inventory_cost_layers")
}

model InventoryMovement {
  id                          String                     @id @default(uuid())
  company_id                  String
  company                     Company                    @relation(fields: [company_id], references: [id], onDelete: Restrict)
  warehouse_id                String
  warehouse                   InventoryWarehouse         @relation(fields: [warehouse_id], references: [id], onDelete: Restrict)
  product_id                  String
  product                     InventoryProduct           @relation(fields: [product_id], references: [id], onDelete: Restrict)
  movement_number             String
  movement_date               DateTime
  accounting_date             DateTime                   @default(now())
  operation_type_code         String                     // Tabla 12 SUNAT (01 Venta, 02 Compra nacional, 18 Importación, 28 Ajuste, 16 Saldo inicial)
  document_type_code          String?                    // Tabla 10 SUNAT (50 DAM, 01 Factura, 09 Guía)
  document_serial             String?
  document_number             String?
  direction                   InventoryMovementDirection
  quantity                    Decimal                    @db.Decimal(12, 4)
  unit_cost                   Decimal                    @db.Decimal(14, 4)
  total_cost                  Decimal                    @db.Decimal(14, 2)
  previous_stock              Decimal                    @db.Decimal(12, 4)
  previous_unit_cost          Decimal                    @db.Decimal(14, 4)
  previous_total_value        Decimal                    @db.Decimal(14, 2)
  resulting_stock             Decimal                    @db.Decimal(12, 4)
  resulting_unit_cost         Decimal                    @db.Decimal(14, 4)
  resulting_total_value       Decimal                    @db.Decimal(14, 2)
  source_reference_id         String?
  source_module               String?                    // INVOICES, CUSTOMS, PURCHASES, INVENTORY
  created_by                  String?
  is_test                     Boolean                    @default(false)
  archived_at                 DateTime?
  notes                       String?
  created_at                  DateTime                   @default(now())

  @@index([company_id, warehouse_id, movement_date])
  @@index([company_id, product_id, movement_date])
  @@unique([company_id, source_reference_id, operation_type_code, product_id])
  @@map("inventory_movements")
}

model InventoryBookObligationDecision {
  id                    String                    @id @default(uuid())
  company_id            String
  company               Company                   @relation(fields: [company_id], references: [id], onDelete: Restrict)
  fiscal_year           Int
  annual_revenue_uit    Decimal                   @db.Decimal(10, 2)
  tax_regime            String
  ple_12_1_status       InventoryObligationStatus
  ple_13_1_status       InventoryObligationStatus
  legal_basis_notes     String?
  evaluated_at          DateTime                  @default(now())

  @@unique([company_id, fiscal_year])
  @@index([company_id])
  @@map("inventory_obligation_decisions")
}

// ---------------------------------------------------------------------------
// Fase 2: transferencias y ajustes
// ---------------------------------------------------------------------------

enum InventoryTransferStatus {
  BORRADOR
  CONFIRMADA
  ANULADA
}

enum InventoryAdjustmentType {
  ENTRADA
  SALIDA
}

enum InventoryAdjustmentStatus {
  BORRADOR
  APLICADO
  ANULADO
}

model InventoryTransfer {
  id                  String                  @id @default(uuid())
  company_id          String
  transfer_number     String
  transfer_date       DateTime
  from_warehouse_code String
  to_warehouse_code   String
  status              InventoryTransferStatus @default(BORRADOR)
  responsible         String?
  notes               String?
  created_at          DateTime                @default(now())
  updated_at          DateTime                @updatedAt

  items               InventoryTransferItem[]

  @@unique([company_id, transfer_number])
  @@index([company_id, transfer_date])
  @@map("inventory_transfers")
}

model InventoryTransferItem {
  id             String            @id @default(uuid())
  transfer_id    String
  transfer       InventoryTransfer @relation(fields: [transfer_id], references: [id], onDelete: Cascade)
  product_id     String
  sku            String
  description    String
  quantity       Decimal           @db.Decimal(12, 4)
  unit_cost      Decimal           @db.Decimal(14, 4)
  total_cost     Decimal           @db.Decimal(14, 2)
  created_at     DateTime          @default(now())

  @@index([transfer_id])
  @@map("inventory_transfer_items")
}

model InventoryAdjustment {
  id                  String                    @id @default(uuid())
  company_id          String
  adjustment_number   String
  adjustment_date     DateTime
  warehouse_code      String
  type                InventoryAdjustmentType
  reason              String
  status              InventoryAdjustmentStatus @default(BORRADOR)
  responsible         String?
  notes               String?
  created_at          DateTime                  @default(now())
  updated_at          DateTime                  @updatedAt

  items               InventoryAdjustmentItem[]

  @@unique([company_id, adjustment_number])
  @@index([company_id, adjustment_date])
  @@map("inventory_adjustments")
}

model InventoryAdjustmentItem {
  id                 String              @id @default(uuid())
  adjustment_id      String
  adjustment         InventoryAdjustment @relation(fields: [adjustment_id], references: [id], onDelete: Cascade)
  product_id         String
  sku                String
  description        String
  system_quantity    Decimal             @db.Decimal(12, 4)
  counted_quantity   Decimal             @db.Decimal(12, 4)
  difference_quantity Decimal            @db.Decimal(12, 4)
  unit_cost          Decimal             @db.Decimal(14, 4)
  created_at         DateTime            @default(now())

  @@index([adjustment_id])
  @@map("inventory_adjustment_items")
}

// ---------------------------------------------------------------------------
// Fase 2: Compras nacionales (Factura de compra, operación 02, IGV crédito fiscal y CxP)
// ---------------------------------------------------------------------------

enum NationalPurchaseStatus {
  REGISTRADA
  PAGO_PARCIAL
  PAGADA
  ANULADA
}

enum ReceptionStatus {
  PENDIENTE
  PARCIAL
  RECIBIDA
}

model NationalPurchase {
  id                  String                 @id @default(uuid())
  company_id          String
  company             Company                @relation(fields: [company_id], references: [id], onDelete: Restrict)
  purchase_number     String                 // COM-2026-0001
  supplier_id         String?
  supplier            BusinessPartner?       @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  supplier_doc_type   String                 @default("6") // 6: RUC
  supplier_doc_number String                 // RUC del proveedor
  supplier_name       String                 // Razón social del proveedor
  document_type_code  String                 @default("01") // 01 Factura, 03 Boleta
  document_serial     String                 // F001, E001
  document_number     String                 // 0001234
  issue_date          DateTime
  accounting_date     DateTime               @default(now())
  currency_code       String                 @default("PEN")
  exchange_rate       Decimal?               @db.Decimal(14, 6)
  warehouse_code      String                 @default("ALM-01")

  net_amount          Decimal                @db.Decimal(14, 2) // Base imponible
  igv_amount          Decimal                @db.Decimal(14, 2) // IGV Crédito fiscal (18%)
  total_amount        Decimal                @db.Decimal(14, 2) // Total CxP proveedor

  status              NationalPurchaseStatus @default(REGISTRADA)
  reception_status    ReceptionStatus        @default(PENDIENTE)
  paid_amount         Decimal                @default(0.00) @db.Decimal(14, 2)
  notes               String?
  responsible         String?

  items               NationalPurchaseItem[]

  created_at          DateTime               @default(now())
  updated_at          DateTime               @updatedAt

  @@unique([company_id, supplier_doc_number, document_type_code, document_serial, document_number], map: "uq_national_purchase_doc")
  @@index([company_id, issue_date])
  @@map("national_purchases")
}

model NationalPurchaseItem {
  id                  String           @id @default(uuid())
  received_quantity   Decimal          @default(0) @db.Decimal(12, 4)
  purchase_id         String
  purchase            NationalPurchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  product_id          String
  product             InventoryProduct @relation(fields: [product_id], references: [id], onDelete: Restrict)
  sku                 String
  description         String
  unit_code           String           @default("NIU")
  quantity            Decimal          @db.Decimal(12, 4)
  unit_cost           Decimal          @db.Decimal(14, 4) // Costo neto unitario sin IGV (para Kardex)
  subtotal            Decimal          @db.Decimal(14, 2) // quantity * unit_cost
  igv_amount          Decimal          @db.Decimal(14, 2) // IGV del ítem (18%)
  total_amount        Decimal          @db.Decimal(14, 2) // subtotal + igv_amount
  created_at          DateTime         @default(now())

  @@index([purchase_id])
  @@index([product_id])
  @@map("national_purchase_items")
}

// ---------------------------------------------------------------------------
// Fase 4: Tesorería y Flujos de Dinero (Caja y Bancos - § 6.4 y § 8.2)
// ---------------------------------------------------------------------------

model TreasuryMovement {
  id                  String   @id @default(uuid())
  company_id          String
  company             Company  @relation(fields: [company_id], references: [id], onDelete: Restrict)
  movement_date       DateTime
  direction           String   // INGRESO, EGRESO
  document_reference  String?  // F001-0001, DAM 118-2026-10-001234, COM-2026-0001
  counterpart_name    String   // Cliente, Proveedor o SUNAT Aduanas
  concept             String   // Cobro factura, Pago proveedor, Tributos aduaneros
  amount              Decimal  @db.Decimal(14, 2)
  currency_code       String   @default("PEN")
  exchange_rate       Decimal? @db.Decimal(14, 6)
  source_module       String   // INVOICES, PURCHASES, CUSTOMS, MANUAL
  source_reference_id String?
  payment_method      String   @default("TRANSFERENCIA") // TRANSFERENCIA, EFECTIVO, CHEQUE, DEPOSITO
  bank_name           String?  // BCP, BBVA, Interbank, Banco de la Nación
  created_at          DateTime @default(now())

  @@index([company_id, movement_date])
  @@index([company_id, direction])
  @@map("treasury_movements")
}

// ---------------------------------------------------------------------------
// Fase 2: Mantenedores de Catálogo, Variantes, Proveedores y Reglas de Precio
// ---------------------------------------------------------------------------

model InventoryBrand {
  id          String   @id @default(uuid())
  company_id  String
  company     Company  @relation(fields: [company_id], references: [id], onDelete: Restrict)
  code        String
  name        String
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([company_id, code])
  @@unique([company_id, name])
  @@index([company_id])
  @@map("inventory_brands")
}

model InventoryModel {
  id          String   @id @default(uuid())
  company_id  String
  company     Company  @relation(fields: [company_id], references: [id], onDelete: Restrict)
  code        String
  name        String
  brand_name  String?
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([company_id, code])
  @@index([company_id])
  @@map("inventory_models")
}

model InventoryCategory {
  id          String   @id @default(uuid())
  company_id  String
  company     Company  @relation(fields: [company_id], references: [id], onDelete: Restrict)
  code        String
  name        String
  sunat_code  String?  // Código oficial según catálogo SUNAT
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([company_id, code])
  @@index([company_id])
  @@map("inventory_categories")
}

model InventoryManufacturer {
  id           String   @id @default(uuid())
  company_id   String
  company      Company  @relation(fields: [company_id], references: [id], onDelete: Restrict)
  name         String
  country_code String   @default("PE")
  website      String?
  contact_info String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([company_id, name])
  @@index([company_id])
  @@map("inventory_manufacturers")
}

model InventoryTag {
  id         String   @id @default(uuid())
  company_id String
  company    Company  @relation(fields: [company_id], references: [id], onDelete: Restrict)
  name       String
  color      String?  @default("emerald")
  created_at DateTime @default(now())

  @@unique([company_id, name])
  @@index([company_id])
  @@map("inventory_tags")
}

model SunatUnitMeasurement {
  code        String   @id // NIU, KGM, BX, LTR, DZN, etc. (Tabla 6 SUNAT)
  name        String   // UNIDAD, KILOGRAMO, CAJA, LITRO...
  symbol      String?  // u, kg, cja, l...
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())

  @@map("sunat_unit_measurements")
}

model InventoryProductSupplier {
  id                    String          @id @default(uuid())
  company_id            String
  company               Company         @relation(fields: [company_id], references: [id], onDelete: Restrict)
  product_id            String
  product               InventoryProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)
  supplier_id           String
  supplier              BusinessPartner @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  supplier_product_code String?
  purchase_cost         Decimal?        @db.Decimal(14, 4)
  currency_code         String          @default("PEN")
  lead_time_days        Int?            @default(0)
  is_preferred          Boolean         @default(false)
  notes                 String?
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt

  @@unique([product_id, supplier_id])
  @@index([company_id, product_id])
  @@index([supplier_id])
  @@map("inventory_product_suppliers")
}

model InventoryProductPresentation {
  id                String           @id @default(uuid())
  company_id        String
  company           Company          @relation(fields: [company_id], references: [id], onDelete: Restrict)
  product_id        String
  product           InventoryProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)
  presentation_name String           // "Caja x 50", "Caja x 100", "Fardo x 24"
  factor            Decimal          @db.Decimal(12, 4) // 50, 100, 24...
  sunat_unit_code   String           @default("BX") // BX, C62, etc.
  barcode           String?
  sale_price        Decimal?         @db.Decimal(14, 2)
  is_default        Boolean          @default(false)
  is_active         Boolean          @default(true)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  @@unique([product_id, presentation_name])
  @@index([company_id, product_id])
  @@map("inventory_product_presentations")
}

model InventoryProductVariant {
  id                String           @id @default(uuid())
  company_id        String
  company           Company          @relation(fields: [company_id], references: [id], onDelete: Restrict)
  product_id        String
  product           InventoryProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)
  sku               String
  variant_name      String           // ej: "Color: Blanco / Medida: 1/2 pulgada"
  attribute_values  Json?            // ej: { "Color": "Blanco", "Medida": "1/2 pulgada" }
  barcode           String?
  additional_cost   Decimal?         @default(0.0000) @db.Decimal(14, 4)
  price_override    Decimal?         @db.Decimal(14, 2)
  current_stock     Decimal?         @default(0.0000) @db.Decimal(12, 4)
  is_active         Boolean          @default(true)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  @@unique([company_id, sku])
  @@index([company_id, product_id])
  @@map("inventory_product_variants")
}




