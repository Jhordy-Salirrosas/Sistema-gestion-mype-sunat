// prisma/schema/sire.prisma

enum SireBookType {
  RVIE_VENTAS
  RCE_COMPRAS
}

enum ReconciliationStatus {
  EN_REVISION
  CONCILIADO
  CERRADO
}

enum DiscrepancyType {
  COINCIDENCIA_EXACTA
  DIFERENCIA_MONTOS
  OMISION_LOCAL
  OMISION_SUNAT
  DUPLICADO_LLAVE
}

enum ResolutionAction {
  ACEPTAR_PROPUESTA_SUNAT
  MANTENER_REGISTRO_LOCAL
  PENDIENTE
}

enum SireDuplicateSource {
  LOCAL
  SIRE
  AMBOS
}

enum SirePeriodState {
  PROPUESTA
  PROCESANDO_REEMPLAZO
  PROCESANDO_PRELIMINAR
  PROCESANDO_ELIMINACION
  CON_PRELIMINAR
  PROCESANDO_GENERACION
  GENERADO
  ERROR
}

enum SirePeriodQueryStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SireRecordOrigin {
  SUNAT
  USUARIO
}

enum SireTicketOperation {
  REEMPLAZO
  REGISTRO_PRELIMINAR
  ELIMINACION_PRELIMINAR
  GENERACION
}

/**
 * Estados de los trabajos asíncronos del menú SIRE.
 *
 * `PENDING` es el estado en el que se registra el trabajo ANTES de publicarlo
 * en la cola: el frontend recibe el `messageId` y sondea el estado hasta que
 * pasa a `COMPLETED` o `FAILED`.
 */
enum SireJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/**
 * Credenciales de la empresa para la integración con SUNAT/SIRE.
 *
 * Cada contribuyente tiene SU propio `client_id`/`client_secret` (credenciales
 * OAuth de la API SIRE) y SU propio usuario SOL con clave. Todo se guarda
 * cifrado con AES-256-GCM (`SOL_CREDENTIAL_CIPHER`); el texto plano nunca
 * llega a la base de datos ni a la cola.
 */
model SireConfiguration {
  id               String   @id @default(uuid())
  company_id       String   @unique
  company          Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  client_id_enc    String?
  client_secret_enc String?
  sol_user_enc     String?
  sol_password_enc String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("sire_configurations")
}

model SirePeriod {
  id              String              @id @default(uuid())
  company_id      String
  company         Company             @relation(fields: [company_id], references: [id], onDelete: Restrict)
  period          String
  book_type       SireBookType
  state           SirePeriodState     @default(PROPUESTA)
  ticket          String?
  ticket_operation SireTicketOperation?
  last_error      String?
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt

  proposals      SireProposal[]

  @@unique([company_id, period, book_type])
  @@index([state, ticket])
  @@map("sire_periods")
}

model SirePeriodQuery {
  id           String                  @id @default(uuid())
  company_id   String
  company      Company                 @relation(fields: [company_id], references: [id], onDelete: Cascade)
  job_id       String?                 @unique
  book_code    String
  status       SirePeriodQueryStatus   @default(PENDING)
  result       String?
  error_code   String?
  created_at   DateTime                @default(now())
  updated_at   DateTime                @updatedAt
  completed_at DateTime?

  @@index([company_id, created_at])
  @@map("sire_period_queries")
}

/**
 * Importación de una propuesta SIRE (archivo `.txt` o `.zip` del contribuyente).
 *
 * Es el registro del TRABAJO, no del contenido: el archivo vive en el
 * almacenamiento de objetos y aquí solo queda su nombre, su ruta y el estado
 * del procesamiento. `message_id` es el identificador que el frontend usa para
 * sondecir el avance (mismo patrón que `SirePeriodQuery.job_id`).
 */
model SireImportacion {
  id              String        @id @default(uuid())
  company_id      String
  company         Company       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  periodo         String
  libro           SireBookType
  nombre_archivo  String
  estado          SireJobStatus @default(PENDING)
  message_id      String?       @unique
  ruta_archivo    String?
  hash_archivo    String?
  backend_almacen String?
  total_registros Int           @default(0)
  error_code      String?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  completed_at    DateTime?

  @@index([company_id, periodo])
  @@index([company_id, created_at])
  @@map("sire_importaciones")
}

/**
 * Resultado de la conciliación de un periodo.
 *
 * `conciliados` y `diferencias` son los contadores del cruce; `detalle` guarda
 * el JSON con el resumen y la lista de comprobantes para poder auditar la
 * conciliación sin volver a simularla.
 */
model SireConciliacion {
  id          String   @id @default(uuid())
  company_id  String
  company     Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  periodo     String
  conciliados Int      @default(0)
  diferencias Int      @default(0)
  detalle     Json?
  created_at  DateTime @default(now())

  @@index([company_id, periodo])
  @@index([company_id, created_at])
  @@map("sire_conciliaciones")
}

/**
 * Envío del libro conciliado a SUNAT.
 *
 * Se registra como trabajo porque el frontend recibe un ticket y un
 * `messageId` y sondea hasta que el envío termina (aquí, la simulación).
 */
model SireReporte {
  id           String        @id @default(uuid())
  company_id   String
  company      Company       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  periodo      String
  libro        SireBookType
  estado       SireJobStatus @default(PENDING)
  message_id   String?       @unique
  ticket       String?
  error_code   String?
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  completed_at DateTime?

  @@index([company_id, periodo])
  @@index([company_id, created_at])
  @@map("sire_reportes")
}

model SireReportUpload {
  id            String        @id @default(uuid())
  company_id    String
  company       Company       @relation(fields: [company_id], references: [id], onDelete: Restrict)
  period        String
  book_type     SireBookType
  archivo_origen String
  tipo_reporte  String
  file_hash     String
  fecha_carga   DateTime      @default(now())
  proposals     SireProposal[]

  @@unique([company_id, file_hash])
  @@index([company_id, period, book_type])
  @@map("sire_report_uploads")
}

model SireProposal {
  id                  String        @id @default(uuid())
  company_id          String
  company             Company       @relation(fields: [company_id], references: [id], onDelete: Restrict)
  period              String
  book_type           SireBookType
  car_sunat           String
  emitter_ruc         String
  emitter_legal_name  String?
  document_type       String
  series              String
  correlative         String
  issue_date          DateTime
  taxable_base        Decimal       @db.Decimal(14, 2)
  igv_amount          Decimal       @db.Decimal(14, 2)
  total_amount        Decimal       @db.Decimal(14, 2)
  raw_line_data       Json?
  imported_at         DateTime      @default(now())
  source_upload_id    String?
  source_upload       SireReportUpload? @relation(fields: [source_upload_id], references: [id], onDelete: SetNull)
  period_id           String?
  period_record       SirePeriod?      @relation(fields: [period_id], references: [id], onDelete: SetNull)
  origin              SireRecordOrigin  @default(SUNAT)
  excluded_at         DateTime?
  excluded_by         String?

  discrepancies       SireDiscrepancy[]

  @@unique([company_id, book_type, car_sunat])
  @@index([company_id, period, document_type, series, correlative])
  @@map("sire_proposals")
}

model SireReconciliation {
  id                    String                @id @default(uuid())
  company_id            String
  company               Company               @relation(fields: [company_id], references: [id], onDelete: Restrict)
  period                String
  book_type             SireBookType
  total_sunat_records   Int
  total_local_records   Int
  exact_matches_count   Int
  discrepancies_count   Int
  status                ReconciliationStatus  @default(EN_REVISION)
  reconciled_by         String?
  reconciler            User?                 @relation(fields: [reconciled_by], references: [id], onDelete: SetNull)
  reconciled_at         DateTime?
  created_at            DateTime              @default(now())

  discrepancies         SireDiscrepancy[]

  @@map("sire_reconciliations")
}

model SireDiscrepancy {
  id                  String             @id @default(uuid())
  reconciliation_id   String
  reconciliation      SireReconciliation @relation(fields: [reconciliation_id], references: [id], onDelete: Cascade)
  discrepancy_type    DiscrepancyType
  emitter_ruc         String?
  document_type       String
  series              String
  correlative         String
  sire_proposal_id    String?
  sire_proposal       SireProposal?      @relation(fields: [sire_proposal_id], references: [id], onDelete: SetNull)
  local_invoice_id    String?
  sire_total_amount   Decimal?           @db.Decimal(14, 2)
  local_total_amount  Decimal?           @db.Decimal(14, 2)
  amount_difference   Decimal?           @default(0.00) @db.Decimal(14, 2)
  taxable_base_difference Decimal?             @db.Decimal(14, 2)
  igv_difference          Decimal?             @db.Decimal(14, 2)
  duplicate_source        SireDuplicateSource?
  resolution_action   ResolutionAction   @default(PENDIENTE)
  resolution_notes    String?
  resolved_at         DateTime?

  @@index([reconciliation_id, discrepancy_type])
  @@map("sire_discrepancies")
}
