// prisma/schema/invoicing.prisma

enum InvoiceStatus {
  PENDIENTE
  EN_COLA
  PROCESANDO
  ENVIADO
  ACEPTADO
  OBSERVADO
  RECHAZADO
  ERROR_RED
  ANULADO
}

model InvoiceSeries {
  id                  String        @id @default(uuid())
  company_id          String
  company             Company       @relation(fields: [company_id], references: [id], onDelete: Restrict)
  document_type       String
  series              String
  current_correlative Int           @default(0)
  is_active           Boolean       @default(true)
  updated_at          DateTime      @updatedAt

  invoices            Invoice[]

  @@unique([company_id, document_type, series])
  @@map("invoice_series")
}

model Invoice {
  transport_uncertain Boolean?
  id                          String        @id @default(uuid())
  company_id                  String
  company                     Company       @relation(fields: [company_id], references: [id], onDelete: Restrict)
  
  // Datos principales de compatibilidad y emisiÃ³n
  ruc_emisor                  String
  serie                       String
  correlativo                 Int
  tipo_comprobante            String
  monto_total                 Decimal       @db.Decimal(14, 2)
  fecha_emision               DateTime
  estado                      InvoiceStatus @default(PENDIENTE)
  payload_ubl                 Json
  cdr_sunat                   Json?
  
  // Campos normativos UBL 2.1 adicionales
  customer_identity_type      String?
  customer_identity_number    String?
  customer_legal_name         String?
  currency_code               String        @default("PEN")
  taxable_operations          Decimal       @default(0.00) @db.Decimal(14, 2)
  exempt_operations           Decimal       @default(0.00) @db.Decimal(14, 2)
  unaffected_operations       Decimal       @default(0.00) @db.Decimal(14, 2)
  total_igv                   Decimal       @default(0.00) @db.Decimal(14, 2)
  sunat_response_code         String?
  sunat_response_notes        Json?
  xml_storage_url             String?
  xml_hash_sha256             String?
  cdr_storage_url             String?
  detraccion_deposited_at     DateTime?
  detraccion_deposited_amount Decimal?   @db.Decimal(14, 2)
  detraccion_constancia       String?
  
  // Referencias para Notas de CrÃ©dito / DÃ©bito
  referenced_invoice_id       String?
  referenced_invoice          Invoice? @relation("InvoiceNotes", fields: [company_id, referenced_invoice_id], references: [company_id, id], onDelete: Restrict, onUpdate: Cascade)
  credit_debit_notes          Invoice[] @relation("InvoiceNotes")
  referenced_document_type    String?
  referenced_series_correlative String?
  credit_debit_reason_code    String?

  series_rel_id               String?
  series_rel                  InvoiceSeries? @relation(fields: [series_rel_id], references: [id])

  items                       InvoiceItem[]
  history                     TransactionHistory[]

  created_at                  DateTime      @default(now())
  updated_at                  DateTime      @updatedAt

  @@unique([company_id, id], map: "uq_invoice_tenant_id")
  @@unique([company_id, tipo_comprobante, serie, correlativo], map: "uq_invoices_fiscal")
  // Llave de idempotencia del envío (TA-32). Es ADICIONAL a uq_invoices_fiscal:
  // defensa en profundidad, no un reemplazo. Un mismo contribuyente puede
  // emitir la misma serie-correlativo desde dos empresas distintas de la
  // plataforma (dos tenants distintos), así que ni (company_id, tipo, serie,
  // correlativo) ni (ruc_emisor, tipo, serie, correlativo) por separado son
  // llaves fiscales completas: juntas sí.
  //
  // Se renombra el argumento `map`; el índice NO se llama como el constraint
  // porque PostgreSQL crea ya un índice con ese nombre para la UNIQUE.
  @@unique([company_id, ruc_emisor, tipo_comprobante, serie, correlativo], map: "uq_invoices_idempotencia")
  @@index([company_id, fecha_emision, estado])
  @@map("invoices")
}

model InvoiceItem {
  id                    String        @id @default(uuid())
  invoice_id            String
  invoice               Invoice       @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  item_order            Int
  item_code             String?
  description           String
  unit_code             String        @default("NIU")
  quantity              Decimal       @db.Decimal(12, 4)
  unit_value            Decimal       @db.Decimal(14, 4)
  unit_price            Decimal       @db.Decimal(14, 4)
  igv_affectation_type  String
  igv_amount            Decimal       @default(0.00) @db.Decimal(14, 2)
  total_amount          Decimal       @db.Decimal(14, 2)

  @@index([invoice_id, item_order])
  @@map("invoice_items")
}

// Private encrypted PKCS#12 objects. Never exposed by Config projections.
model IssuerCertificate {
  id String @id
  company_id String
  encrypted_content String
  created_at DateTime @default(now())
  @@index([company_id])
  @@map("issuer_certificates")
}

// Respuesta durable de creación; la misma clave no puede representar otra venta.
model InvoiceCreationRequest {
  id          String @id @default(uuid())
  company_id  String
  request_key String @db.VarChar(128)
  fingerprint String @db.VarChar(64)
  response    Json
  created_at  DateTime @default(now())

  @@unique([company_id, request_key])
  @@map("invoice_creation_requests")
}

// M1 RA/RC: reserva, artefacto inmutable, miembros y recuperación de ticket.
model InvoiceAggregate {
  id                  String   @id @default(uuid())
  company_id          String
  kind                String   @db.VarChar(2)
  identifier          String   @db.VarChar(32)
  fingerprint         String   @db.VarChar(64)
  reference_date      String   @db.VarChar(10)
  generation_date     String   @db.VarChar(10)
  state               String   @default("RESERVED")
  issuer_ruc          String   @db.VarChar(11)
  environment         String
  xml                 String?
  xml_hash            String?
  zip_base64          String?
  members             Json
  ticket              String?
  transport_uncertain Boolean  @default(false)
  result              Json?
  error               String?
  job_id              String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@unique([company_id, kind, identifier])
  @@unique([company_id, kind, fingerprint])
  @@index([company_id, state, created_at])
  @@map("invoice_aggregates")
}
