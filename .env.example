PORT=3000
SUPABASE_URL=tu_supabase_project_url
SUPABASE_KEY=tu_supabase_anon_key
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
API_KEY=cambia_esto_por_una_clave_larga_y_segura

# ===================================================
# GESTION DE CERTIFICADO DIGITAL X.509 (SUNAT - TA-04)
# ===================================================
RUC_EMISOR="20601234567"
CERT_PASSWORD="<TU_CLAVE_AQUI>"
CERT_BASE64="<CERTIFICADO_PKCS12_EN_BASE64>"

# --- Cliente SOAP del billService de SUNAT (TA-03) -------------------------
# Endpoint explicito. Si se define, tiene prioridad sobre SUNAT_ENV.
# Para probar contra el Mock local:
# SUNAT_BILL_SERVICE_URL=http://localhost:3000/api/v1/mocks/sunat/billService
# SUNAT_BILL_SERVICE_URL=

# Entorno de SUNAT: beta (homologacion, por defecto) o produccion.
SUNAT_ENV=beta

# Timeout de la peticion SOAP, en milisegundos.
SUNAT_TIMEOUT_MS=30000

# Credenciales SOL (usuario secundario) para el encabezado WS-Security.
# Sin estas variables el sobre SOAP se envia SIN WS-Security, que es lo que
# necesita el Mock de TA-06. Nunca se versionan credenciales reales.
# SUNAT_SOL_USER=MODDATOS
# SUNAT_SOL_PASSWORD=tu_clave_sol
