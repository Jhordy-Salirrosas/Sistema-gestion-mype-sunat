PORT=3000
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=
DIRECT_URL=
API_KEY=cambia_esto_por_una_clave_larga_y_segura
JWT_SECRET=cambia_esto_por_un_secreto_jwt_largo_y_seguro_minimo_32_caracteres
# Inyectar desde un secret manager en produccion; clave aleatoria de 32 bytes codificada en Base64.
SOL_CREDENTIALS_ENCRYPTION_KEY=

# Certificado PKCS#12 local: no guardar claves privadas en el repositorio.
RUC_EMISOR=20000000001
CERT_PASSWORD=
CERT_BASE64=

# SUNAT beta es el entorno predeterminado; produccion requiere cambio explicito.
SUNAT_ENV=beta
# SIRE mock local. No usar modo real hasta implementar y configurar OAuth SIRE.
SUNAT_SIRE_ENV=mock
# Consultas de períodos RVIE/RCE (solo lectura), desactivadas por defecto.
# Configurar solo tras verificar el contrato oficial. Enviar estas consultas
# contacta directamente los servicios SUNAT configurados.
SUNAT_SIRE_INTEGRATION_ENABLED=false
# SUNAT_CLIENT_ID debe ser el Client ID real, inyectado desde el secret manager.
# No usar valores como "tu-id-sin-espacios" ni guardar secretos aquí.
SIRE_AUTH_HOST=
SIRE_API_HOST=
SUNAT_CLIENT_ID=
SUNAT_CLIENT_SECRET=
SUNAT_SIRE_READONLY_TIMEOUT_MS=10000
SUNAT_BILL_SERVICE_URL_BETA=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_BILL_SERVICE_URL_PRODUCCION=https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService
# Opcional, tiene precedencia sobre el endpoint determinado por SUNAT_ENV.
# SUNAT_BILL_SERVICE_URL=http://localhost:3000/api/v1/mocks/sunat/billService
SUNAT_TIMEOUT_MS=30000

# Consulta de padrón RUC mediante un proveedor autorizado.
# La URL puede contener {ruc}; si no, el backend agrega /{ruc}.
# No configurar una URL inventada: sin proveedor el endpoint responde 503.
# Decolecta (recomendado): token Bearer del panel de Decolecta.
# SUNAT_RUC_PROVIDER=decolecta
# DECOLECTA_API_TOKEN=
# DECOLECTA_API_URL=https://api.decolecta.com/v1/sunat/ruc?numero={ruc}
# Proveedor generico alternativo:
# SUNAT_RUC_SERVICE_URL=https://proveedor-autorizado.example/ruc/{ruc}
# SUNAT_RUC_SERVICE_API_KEY=
SUNAT_RUC_CACHE_TTL_SECONDS=86400

# Credenciales de homologacion de SUNAT (secundario: RUC + usuario).
# Valores estandar de prueba: usuario MODDATOS y clave moddatos.
# Nunca imprimir ni versionar credenciales en logs o archivos compartidos.
SUNAT_SOL_USER=
SUNAT_SOL_PASSWORD=

# Solo para el test manual opt-in contra Beta; nunca se ejecuta en la suite normal.
RUN_SUNAT_BETA_INTEGRATION=false
SUNAT_BETA_RUC=20000000001
SUNAT_BETA_CERT_PASSWORD=
SUNAT_BETA_CERT_BASE64=
SUNAT_BETA_DATABASE_URL=
SUNAT_BETA_INVOICE_ID=
SUNAT_BETA_SERIE=F001
SUNAT_BETA_CORRELATIVO=
SUNAT_BETA_LEGAL_NAME=

# Validación oficial: assets/sunat-sfs/ mediante Python + lxml.
# Los fallos del motor bloquean el envío; no existe selector de motor legado.
