PORT=3000
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=
DIRECT_URL=
API_KEY=cambia_esto_por_una_clave_larga_y_segura
JWT_SECRET=cambia_esto_por_un_secreto_jwt_largo_y_seguro_minimo_32_caracteres

# Certificado PKCS#12 local: no guardar claves privadas en el repositorio.
RUC_EMISOR=20000000001
CERT_PASSWORD=
CERT_BASE64=

# SUNAT beta es el entorno predeterminado; produccion requiere cambio explicito.
SUNAT_ENV=beta
SUNAT_BILL_SERVICE_URL_BETA=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_BILL_SERVICE_URL_PRODUCCION=https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService
# Opcional, tiene precedencia sobre el endpoint determinado por SUNAT_ENV.
# SUNAT_BILL_SERVICE_URL=http://localhost:3000/api/v1/mocks/sunat/billService
SUNAT_TIMEOUT_MS=30000

# Credenciales de homologacion de SUNAT (secundario: RUC + usuario).
# Valores estandar de prueba: usuario MODDATOS y clave moddatos.
# Nunca imprimir ni versionar credenciales en logs o archivos compartidos.
SUNAT_SOL_USER=
SUNAT_SOL_PASSWORD=

# Solo para el test manual opt-in contra Beta; nunca se ejecuta en la suite normal.
RUN_SUNAT_BETA_INTEGRATION=false
SUNAT_BETA_RUC=20000000001
SUNAT_BETA_CERT_PASSWORD=
SUNAT_BETA_CERT_BASE64=
SUNAT_BETA_DATABASE_URL=
SUNAT_BETA_INVOICE_ID=
SUNAT_BETA_SERIE=F001
SUNAT_BETA_CORRELATIVO=
SUNAT_BETA_LEGAL_NAME=

# TA-31: directorio con las hojas XSL oficiales de SUNAT.
# Se descargan de https://ayuda.nubefact.com/descargas , seccion
# "MANUALES SUNAT - Reglas de Validacion (XSL)". Hacen falta estas cuatro,
# con estos nombres EXACTOS (el validador las busca por nombre):
#   Factura 2.0.1.xsl
#   Boleta 2.0.1.xsl
#   Nota de Credito 2.0.1.xsl
#   Nota de Debito 2.0.1.xsl
# No se versionan en el repositorio (material de SUNAT, ~1.5 MB, cambian con
# el estandar). Si la variable falta o la hoja no esta, el envio se BLOQUEA a
# proposito: no se valida a ciegas un comprobante tributario.
#   Windows: SUNAT_XSL_DIR=C:\sunat-xsl
#   Linux:   SUNAT_XSL_DIR=/opt/sunat-xsl
# SUNAT_XSL_DIR=
