# ==============================================================================
# SYNC-SUNAT — .gitignore
# ==============================================================================

# Dependencias
node_modules/
.pnp
.pnp.js

# Carpeta personal / Documentación
docs/

# Variables de Entorno y Secretos (Seguridad)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# Conservar plantilla pública de variables de entorno para el equipo
!.env.example

# Compilación y Salidas de Build
dist/
dist-ssr/
build/
*.tsbuildinfo

# Logs y Depuración
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cobertura y Pruebas
coverage/
*.lcov

# Configuraciones de Editor e IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# Archivos del Sistema Operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
